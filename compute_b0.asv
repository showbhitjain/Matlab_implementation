function [b_0] = compute_b0(r_oc,Jacobi_critical_max,joint_velocity_critical,d_stop,d_influence,k)

b_0_first = -r_0c* Jacobi_critical_max * joint_velocity_critical * joint_velocity_critical;
if b_0_first <= 0
    b_0 = b_0_first;
end

if b_0_first > 0
    b_0 = smoothing_constraint_scheme_2 * b_0_first
end
end