build $builddir/isDeltaXTooSmall.o : cxx $root/isDeltaXTooSmall.cpp
build $builddir/_coder_inverseKinematicsOAModified_api.o : cxx $root/interface/_coder_inverseKinematicsOAModified_api.cpp
build $builddir/_coder_inverseKinematicsOAModified_mex.o : cxx $root/interface/_coder_inverseKinematicsOAModified_mex.cpp
