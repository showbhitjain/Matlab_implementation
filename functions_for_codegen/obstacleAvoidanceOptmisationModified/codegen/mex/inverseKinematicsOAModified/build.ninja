# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2023b
startdir = /home/shobhit/ShobhitRobotModelling/robotmodelling/Matlab_implementation/functions_for_codegen/obstacleAvoidanceOptmisationModified

# Toolchain information
cc = gcc
cxx = /usr/bin/g++
linker = gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fvisibility=hidden -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=inverseKinematicsOAModified_mex -DMW_NEEDS_VERSION_H -msse2 -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fvisibility=hidden -fno-gnu-unique -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=inverseKinematicsOAModified_mex -DMW_NEEDS_VERSION_H -msse2 -c 

ldflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o inverseKinematicsOAModified_mex.mexa64 -Wl,--exclude-libs,ALL -L"$matlabdir/bin/glnxa64" -lmwblas -lmwlapack -lemlrt -lcovrt -lut -lmwmathutil 

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/inverseKinematicsOAModified_data.o : cxx $root/inverseKinematicsOAModified_data.cpp
build $builddir/rt_nonfinite.o : cxx $root/rt_nonfinite.cpp
build $builddir/inverseKinematicsOAModified_initialize.o : cxx $root/inverseKinematicsOAModified_initialize.cpp
build $builddir/inverseKinematicsOAModified_terminate.o : cxx $root/inverseKinematicsOAModified_terminate.cpp
build $builddir/inverseKinematicsOAModified.o : cxx $root/inverseKinematicsOAModified.cpp
build $builddir/abs.o : cxx $root/abs.cpp
build $builddir/ixfun.o : cxx $root/ixfun.cpp
build $builddir/mtimes.o : cxx $root/mtimes.cpp
build $builddir/eye.o : cxx $root/eye.cpp
build $builddir/checkX0.o : cxx $root/checkX0.cpp
build $builddir/checkLinearInputs.o : cxx $root/checkLinearInputs.cpp
build $builddir/all.o : cxx $root/all.cpp
build $builddir/any1.o : cxx $root/any1.cpp
build $builddir/factoryConstruct.o : cxx $root/factoryConstruct.cpp
build $builddir/factoryConstruct1.o : cxx $root/factoryConstruct1.cpp
build $builddir/factoryConstruct2.o : cxx $root/factoryConstruct2.cpp
build $builddir/indexShapeCheck.o : cxx $root/indexShapeCheck.cpp
build $builddir/configurableObjective.o : cxx $root/configurableObjective.cpp
